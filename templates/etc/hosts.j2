# Managed by ansible.
# file: {{ template_destpath }}

# Loopback records
127.0.0.1 localhost.localdomain localhost
{% if __hosts_ipv6_interfaces.matched > 0 %}
::1 localhost6.localdomain6 localhost6 localhost ip6-localhost ip6-loopback
fe00::0 ip6-localnet
ff00::0 ip6-mcastprefix
ff02::1 ip6-allnodes
ff02::2 ip6-allrouters
{% endif %}

# Local host records
{% set __hosts_names = ([ansible_facts.hostname ~ '.' ~ hosts_domain] if hosts_domain else []) + [ansible_facts.hostname] %}
{% if hosts_ip_all | bool %}
{% set __hosts_addresses = ansible_facts.all_ipv4_addresses + ansible_facts.all_ipv6_addresses %}
{% elif hosts_ip_static | bool or not __hosts_dhcp_routes.stdout %}
{% set __hosts_addresses = [hosts_ip_address] %}
{% else %}
{% set __hosts_addresses = ['127.0.1.1'] %}
{% endif %}
{% for __hosts_address in __hosts_addresses if __hosts_ipv6_interfaces.matched > 0 or ':' not in __hosts_address %}
{{ __hosts_address }} {{ __hosts_names | join(' ') }}
{% endfor %}
{% set __hosts_additional = namespace(records=[]) %}
{% for __hosts_entry in hosts_entries if __hosts_ipv6_interfaces.matched > 0 or ':' not in __hosts_entry.ip %}
{% set __hosts_entry_names = ([__hosts_entry.name] + (__hosts_entry.aliases | default([]))) | reject('in', __hosts_names) | list %}
{% if __hosts_entry_names %}
{% set __hosts_additional.records = __hosts_additional.records + [[__hosts_entry.ip] + __hosts_entry_names] %}
{% endif %}
{% endfor %}
{% for __hosts_record in __hosts_additional.records %}
{% if loop.first %}

# Additional host records
{% endif %}
{{ __hosts_record | join(' ') }}
{% endfor %}
